{% if album_page_template|default('') == 'axel' %}
<script nonce="{{ csp_nonce() }}">
(function () {
  if (!document.body.classList.contains('axel-album-shell')) return;
  window.addEventListener('wheel', function (event) {
    if (window.innerWidth <= 768 || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
    event.preventDefault();
    window.scrollBy({ left: event.deltaY, behavior: 'auto' });
  }, { passive: false });
})();
</script>

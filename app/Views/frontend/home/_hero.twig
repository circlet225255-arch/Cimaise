{% set hero_title = home_settings.hero_title|default('')|trim %}
{% set hero_subtitle = home_settings.hero_subtitle|default('')|trim %}
{% if hero_title or hero_subtitle %}
<div class="text-center py-12 md:py-20">
  {% if hero_title %}<h1 class="text-4xl md:text-6xl font-light text-black mb-6">{{ hero_title|e }}</h1>{% endif %}
  {% if hero_subtitle %}<p class="text-lg md:text-xl text-neutral-600 max-w-2xl mx-auto leading-relaxed">{{ hero_subtitle|e }}</p>{% endif %}
</div>
{% endif %}

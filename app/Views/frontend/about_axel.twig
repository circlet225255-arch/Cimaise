{% extends 'frontend/_layout.twig' %}
{% set needs_vendor_scripts = false %}

{% block styles %}
<style nonce="{{ csp_nonce() }}">
  .axel-about-shell { background: var(--retro-olive-deep); color: var(--retro-paper-light); }
  .axel-about-shell #main-header, .axel-about-shell > footer { display: none; }
  .axel-about-shell #main-content { margin: 0; }
  .axel-about { overflow: clip; background: var(--retro-olive-deep); font-family: var(--font-body, Inter, system-ui, sans-serif); }
  .axel-about-nav { position: absolute; z-index: 5; top: 0; left: 0; right: 0; display: grid; grid-template-columns: 1fr 1fr auto; gap: 2rem; padding: 1.3rem clamp(1rem, 2.4vw, 2rem); color: white; font-size: .68rem; letter-spacing: .11em; text-transform: uppercase; }
  .axel-about-nav a, .axel-about a { color: inherit; text-decoration: none; }
  .axel-about-brand { font-size: .8rem; font-weight: 700; letter-spacing: -.035em; }
  .axel-about-nav__copy { color: rgba(248,242,230,.72); }
  .axel-about-nav__links { display: flex; justify-content: flex-end; gap: clamp(.8rem, 2vw, 2rem); }
  .axel-about-nav__links a:hover, .axel-about a:hover { opacity: .65; }
  .axel-about-hero { position: relative; min-height: min(100svh, 980px); display: flex; align-items: end; overflow: hidden; background: var(--retro-oxide-deep); }
  .axel-about-hero__image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; opacity: .82; }
  .axel-about-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(160,15,22,.58), rgba(43,0,0,.28) 48%, rgba(0,0,0,.75)); mix-blend-mode: multiply; }
  .axel-about-hero__content { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: end; gap: 2rem; width: 100%; padding: clamp(7rem, 16vw, 14rem) clamp(1rem, 2.4vw, 2rem) clamp(2rem, 5vw, 5rem); }
  .axel-about-hero h1 { max-width: 9ch; margin: 0; font-size: clamp(4rem, 15vw, 15rem); line-height: .72; letter-spacing: -.1em; font-weight: 700; text-transform: uppercase; }
  .axel-about-hero__kicker { max-width: 18rem; margin: 0; font-size: .68rem; line-height: 1.5; letter-spacing: .13em; text-transform: uppercase; }
  .axel-about-body { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(14rem, .8fr); gap: clamp(2rem, 8vw, 9rem); align-items: start; max-width: 1500px; margin: 0 auto; padding: clamp(4rem, 10vw, 10rem) clamp(1rem, 4vw, 4rem); }
  .axel-about-label { display: inline-flex; padding: .35rem .75rem; border: 1px solid var(--retro-muted); border-radius: 99px; font-size: .62rem; letter-spacing: .13em; text-transform: uppercase; }
  .axel-about-copy { margin-top: 1.5rem; font-size: clamp(1.25rem, 3.2vw, 3rem); line-height: 1.18; letter-spacing: -.035em; }
  .axel-about-copy p { margin: 0 0 1.2em; }
  .axel-about-copy p:last-child { margin-bottom: 0; }
  .axel-about-subtitle { margin-top: 1rem; color: var(--retro-border-strong); font-size: .82rem; line-height: 1.6; }
  .axel-about-portrait { position: sticky; top: 2rem; aspect-ratio: .72; overflow: hidden; background: var(--retro-olive-deep); }
  .axel-about-portrait img { width: 100%; height: 100%; display: block; object-fit: cover; filter: saturate(.75) contrast(1.04); }
  .axel-about-socials { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2.5rem; }
  .axel-about-socials a, .axel-contact-button { display: inline-flex; align-items: center; padding: .7rem 1rem; border: 1px solid var(--retro-muted); border-radius: 99px; font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  .axel-contact { max-width: 1500px; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 4rem) clamp(4rem, 10vw, 10rem); }
  .axel-contact__inner { padding-top: 1.25rem; border-top: 1px solid var(--retro-muted); }
  .axel-contact h2 { margin: 0; font-size: clamp(2rem, 6vw, 5rem); line-height: .9; letter-spacing: -.075em; text-transform: uppercase; }
  .axel-contact__intro { max-width: 44rem; margin: 1rem 0 2rem; color: var(--retro-border-strong); line-height: 1.6; }
  .axel-contact__form { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; max-width: 52rem; }
  .axel-contact__field { display: grid; gap: .45rem; font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  .axel-contact__field--wide { grid-column: 1 / -1; }
  .axel-contact__field input, .axel-contact__field textarea { width: 100%; border: 1px solid var(--retro-muted); border-radius: 0; background: var(--retro-olive-deep); color: var(--retro-paper-light); padding: .8rem; font: inherit; letter-spacing: 0; text-transform: none; }
  .axel-contact__field textarea { min-height: 9rem; resize: vertical; }
  .axel-contact__messages { margin-bottom: 1.5rem; }
  .axel-contact__messages p { padding: .8rem 1rem; border: 1px solid var(--retro-muted); }
  .axel-about-footer { display: flex; justify-content: space-between; gap: 1rem; margin: 0 clamp(1rem, 2.4vw, 2rem); padding: .9rem 0 1.2rem; border-top: 1px solid var(--retro-muted); color: var(--retro-border-strong); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 768px) {
    .axel-about-nav { grid-template-columns: 1fr auto; gap: 1rem; }
    .axel-about-nav__copy { display: none; }
    .axel-about-nav__links { gap: .8rem; }
    .axel-about-nav__links a { font-size: .58rem; }
    .axel-about-hero { min-height: 83svh; }
    .axel-about-hero__content { display: block; }
    .axel-about-hero h1 { font-size: clamp(4.2rem, 19vw, 8rem); }
    .axel-about-hero__kicker { margin-top: 2rem; }
    .axel-about-body { grid-template-columns: 1fr; }
    .axel-about-portrait { position: relative; top: auto; width: min(76%, 360px); margin-left: auto; }
  }
  @media (max-width: 430px) {
    .axel-about-nav { padding: 1rem; }
    .axel-about-nav__links { gap: .55rem; }
    .axel-about-nav__links a { font-size: .54rem; }
    .axel-contact__form { grid-template-columns: 1fr; }
    .axel-contact__field--wide { grid-column: auto; }
    .axel-about-footer { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .axel-about *, .axel-about *::before, .axel-about *::after { scroll-behavior: auto; transition-duration: .01ms; } }
  body.axel-about-shell { background: var(--retro-paper); color: var(--retro-ink); }
  .axel-about { background: var(--retro-paper); color: var(--retro-ink); }
  .axel-about-nav { position: relative; display: grid; grid-template-columns: minmax(9rem, 1fr) auto; align-items: center; gap: 2rem; padding: 1.1rem clamp(1rem, 3vw, 3rem); border-bottom: 1px solid rgba(41,40,32,.16); color: var(--retro-ink); }
  .axel-about-brand, .axel-about-nav a { color: inherit; }
  .axel-about-nav__copy { display: none; }
  .axel-about-nav__links a { padding-bottom: .25rem; border-bottom: 1px solid transparent; transition: border-color .2s ease, opacity .2s ease; }
  .axel-about-nav__links a:hover, .axel-about-nav__links a[aria-current="page"] { border-color: currentColor; opacity: 1; }
  .axel-about a:focus-visible { outline: 2px solid var(--retro-oxide); outline-offset: 4px; }
  .axel-about-hero { min-height: min(720px, 72svh); align-items: stretch; background: radial-gradient(circle at 80% 25%, rgba(166,83,57,.38), transparent 24%), linear-gradient(130deg, var(--retro-olive-dark), var(--retro-olive-dark) 67%, var(--retro-olive-deep)); }
  .axel-about-hero__image { opacity: .67; }
  .axel-about-hero::after { background: linear-gradient(90deg, rgba(18,22,19,.82), rgba(18,22,19,.16) 100%); mix-blend-mode: normal; }
  .axel-about-hero__content { align-items: end; padding: clamp(4rem, 9vw, 8rem) clamp(1rem, 5vw, 5rem) clamp(2rem, 5vw, 4rem); }
  .axel-about-hero__eyebrow { margin: 0 0 1rem; color: var(--retro-oxide-soft); font-size: .66rem; letter-spacing: .13em; text-transform: uppercase; }
  .axel-about-hero h1 { max-width: 9ch; color: var(--retro-paper); font-size: clamp(4.5rem, 12vw, 11rem); line-height: .82; letter-spacing: -.085em; text-transform: none; }
  .axel-about-hero__kicker { max-width: 21rem; margin: 0; color: var(--retro-paper); font-size: clamp(.95rem, 1.3vw, 1.1rem); line-height: 1.5; letter-spacing: 0; text-transform: none; }
  .axel-about-hero__actions { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 1.4rem; }
  .axel-about-hero__actions a { display: inline-flex; align-items: center; min-height: 2.7rem; padding: .65rem .95rem; border: 1px solid rgba(248,242,230,.74); border-radius: 99px; color: white; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  .axel-about-hero__actions a:hover { background: white; color: var(--retro-ink); opacity: 1; }
  .axel-about-body { grid-template-columns: minmax(0, 1.2fr) minmax(15rem, .8fr); }
  .axel-about-body--media-only { grid-template-columns: minmax(0, 1fr); max-width: 900px; }
  .axel-about-body--media-only .axel-about-portrait { position: relative; top: auto; width: min(100%, 620px); margin: 0 auto; }
  .axel-about-label { border-color: var(--retro-border-strong); color: var(--retro-muted); }
  .axel-about-copy { max-width: 18ch; color: var(--retro-ink); font-size: clamp(1.5rem, 3vw, 2.9rem); line-height: 1.16; }
  .axel-about-copy p { margin-bottom: .9em; }
  .axel-about-portrait { display: grid; place-items: center; background: radial-gradient(circle at 70% 27%, rgba(166,83,57,.8), transparent 24%), radial-gradient(circle at 30% 77%, rgba(89,98,79,.9), transparent 43%), linear-gradient(145deg, var(--retro-paper-deep), var(--retro-olive-soft)); color: var(--retro-ink); }
  .axel-about-portrait__placeholder { position: relative; display: flex; width: 76%; aspect-ratio: .82; flex-direction: column; justify-content: space-between; padding: 1rem; border: 1px solid rgba(41,40,32,.35); transform: rotate(-5deg); }
  .axel-about-portrait__placeholder span { font-size: .6rem; letter-spacing: .13em; text-transform: uppercase; }
  .axel-about-portrait__placeholder strong { align-self: end; padding: .6rem .75rem; background: var(--retro-paper); font-size: clamp(1.7rem, 3.5vw, 3.4rem); line-height: .87; letter-spacing: -.075em; font-weight: 500; }
  .axel-about-socials a, .axel-contact-button { border-color: var(--retro-muted); color: var(--retro-ink); transition: background .2s ease, color .2s ease; }
  .axel-about-socials a:hover, .axel-contact-button:hover { background: var(--retro-ink); color: white; opacity: 1; }
  .axel-contact { padding-bottom: clamp(4rem, 10vw, 9rem); }
  .axel-contact__inner { border-top-color: rgba(41,40,32,.24); }
  .axel-contact h2 { max-width: 12ch; font-size: clamp(2.7rem, 7vw, 6rem); text-transform: none; }
  .axel-contact__intro { color: var(--retro-muted); }
  .axel-contact__details { display: flex; flex-wrap: wrap; gap: .6rem 1.4rem; margin: -1rem 0 2rem; color: var(--retro-muted); font-size: .9rem; }
  .axel-contact__details a { text-decoration: underline; text-underline-offset: .2em; }
  .axel-contact__field { color: var(--retro-muted); }
  .axel-contact__field input, .axel-contact__field textarea { border-color: var(--retro-paper-deep); background: var(--retro-paper-mid); color: var(--retro-ink); }
  .axel-contact__field input:focus, .axel-contact__field textarea:focus { border-color: var(--retro-oxide); outline: 2px solid rgba(166,83,57,.18); }
  .axel-contact__field input::placeholder, .axel-contact__field textarea::placeholder { color: var(--retro-muted); }
  .axel-about-footer { border-top-color: rgba(41,40,32,.2); color: var(--retro-muted); }
  @media (max-width: 768px) {
    .axel-about-nav { grid-template-columns: 1fr auto; gap: .8rem; padding: 1rem; }
    .axel-about-nav__copy { display: none; }
    .axel-about-hero { min-height: 76svh; }
    .axel-about-hero__content { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 1.5rem; padding: 5rem 1rem 2rem; }
    .axel-about-hero h1 { font-size: clamp(4rem, 15vw, 7rem); }
    .axel-about-hero__kicker { max-width: 27rem; }
    .axel-about-body { grid-template-columns: 1fr; padding: 4rem 1rem; }
    .axel-about-copy { max-width: 22ch; }
    .axel-about-portrait { position: relative; top: auto; width: min(84%, 420px); margin-left: auto; }
  }
  @media (max-width: 430px) {
    .axel-about-nav { display: flex; justify-content: space-between; gap: .6rem; }
    .axel-about-nav__links { gap: .7rem; }
    .axel-about-nav__links a { font-size: .57rem; }
    .axel-about-footer { flex-direction: column; }
  }
</style>
{% endblock %}

{% block content %}
{% if recaptcha_enabled and recaptcha_site_key %}
<script nonce="{{ csp_nonce() }}" src="https://www.google.com/recaptcha/api.js?render={{ recaptcha_site_key|e('url') }}"></script>
<script nonce="{{ csp_nonce() }}">
document.addEventListener('DOMContentLoaded', function () {
  const form = document.querySelector('.axel-contact__form');
  if (!form || !window.grecaptcha) return;
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    window.grecaptcha.ready(function () {
      window.grecaptcha.execute('{{ recaptcha_site_key|e('js') }}', { action: 'contact' }).then(function (token) {
        let input = form.querySelector('input[name="recaptcha_token"]');
        if (!input) { input = document.createElement('input'); input.type = 'hidden'; input.name = 'recaptcha_token'; form.appendChild(input); }
        input.value = token;
        form.submit();
      });
    });
  });
});
</script>
{% endif %}
<script type="application/ld+json" nonce="{{ csp_nonce() }}">{
  "@context":"https://schema.org","@type":"ProfilePage",
  "name":{{ about_title|default(trans('nav.about'))|json_encode|raw }},
  "url":{{ (canonical_url|default(current_url))|json_encode|raw }},
  "mainEntity":{"@type":"Person","name":{{ about_title|default(site_title)|json_encode|raw }}{% if about_photo_url %},"image":{{ (about_photo_url starts with '/' ? base_path ~ about_photo_url : about_photo_url)|json_encode|raw }}{% endif %}}
}</script>

<div class="axel-about">
  <nav class="axel-about-nav" aria-label="Main navigation">
    {% if site_title|default('')|trim %}<a class="axel-about-brand" href="{{ base_path }}/">{{ site_title|e }}</a>{% endif %}
    <div class="axel-about-nav__links">
      <a href="{{ base_path }}/">Trang chủ</a>
      <a href="{{ base_path }}/{{ galleries_slug|default('galleries')|e('html_attr') }}">Tác phẩm</a>
      <a href="{{ about_url starts with '/' ? about_url : '/' ~ about_url }}" aria-current="page">Giới thiệu</a>
      <a href="#contact">Liên hệ</a>
    </div>
  </nav>

  <header class="axel-about-hero">
    {% if about_photo_url %}<img class="axel-about-hero__image" src="{{ about_photo_url starts with '/' ? base_path ~ about_photo_url : about_photo_url }}" alt="{{ trans('about.portrait_alt')|e('html_attr') }}" fetchpriority="high" data-about-photo="1">{% endif %}
    <div class="axel-about-hero__content">
      {% set profile_title = about_title|default('Nguyễn Đình Việt Thái')|trim %}
      <h1>{{ profile_title|e }}</h1>
      <div class="axel-about-hero__actions"><a href="{{ base_path }}/{{ galleries_slug|default('galleries')|e('html_attr') }}">Xem tác phẩm ↗</a><a href="#contact">Liên hệ ↗</a></div>
    </div>
  </header>

  <section class="axel-about-body{% if not about_text and not about_socials|default({}) %} axel-about-body--media-only{% endif %}">
    {% if about_text or about_socials|default({}) %}
    <div>
      {% if about_text %}<div class="axel-about-copy rich-text-content">{{ about_text|safe_html }}</div>{% endif %}
      {% if about_socials|default({}) %}
      <div class="axel-about-socials">
        {% for key, url in about_socials %}<a href="{{ url|e('html_attr') }}" target="_blank" rel="me noopener">{{ key|e }} ↗</a>{% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
    <div class="axel-about-portrait">
      {% if about_photo_url %}<img src="{{ about_photo_url starts with '/' ? base_path ~ about_photo_url : about_photo_url }}" alt="" loading="lazy" decoding="async">{% else %}<div class="axel-about-portrait__placeholder" aria-hidden="true"></div>{% endif %}
    </div>
  </section>

  <section class="axel-contact" id="contact">
    <div class="axel-contact__inner">
      {% if contact_sent or contact_error %}<div class="axel-contact__messages" role="status">{% if contact_sent %}<p>{{ trans('contact.success') }}</p>{% else %}<p>{{ trans('contact.error') }}</p>{% endif %}</div>{% endif %}
      {% set profile_contact_title = contact_title|default('') %}
      <h2>{% if profile_contact_title and profile_contact_title != 'Contatti' and profile_contact_title != 'Contact' %}{{ profile_contact_title|e }}{% else %}Liên hệ{% endif %}</h2>
      {% if contact_intro or about_footer_text %}<div class="axel-contact__intro">{% if contact_intro %}{{ contact_intro|safe_html }}{% else %}{{ about_footer_text|safe_html }}{% endif %}</div>{% endif %}
      {% if contact_email or contact_phone %}
      <div class="axel-contact__details" aria-label="Thông tin liên hệ">
        {% if contact_email %}<a href="mailto:{{ contact_email|e('html_attr') }}">Email · {{ contact_email|e }}</a>{% endif %}
        {% if contact_phone %}<a href="tel:{{ contact_phone|replace({' ': '', '-': '', '.': ''})|e('html_attr') }}">Điện thoại · {{ contact_phone|e }}</a>{% endif %}
      </div>
      {% endif %}
      <form method="post" action="{{ about_url }}/contact" class="axel-contact__form">
        <input type="hidden" name="csrf" value="{{ csrf|e('html_attr') }}">
        <label class="axel-contact__field"><span>Họ tên</span><input type="text" name="name" autocomplete="name" required></label>
        <label class="axel-contact__field"><span>Email</span><input type="email" name="email" autocomplete="email" required></label>
        <label class="axel-contact__field axel-contact__field--wide"><span>Lời nhắn</span><textarea name="message" rows="5" required></textarea></label>
        <div><button type="submit" class="axel-contact-button">Gửi lời nhắn ↗</button></div>
      </form>
    </div>
  </section>

  <footer class="axel-about-footer">{% if site_copyright|default('')|trim %}<span>{{ site_copyright|replace_year }}</span>{% endif %}<a href="#contact">Liên hệ ↗</a></footer>
</div>
{% endblock %}

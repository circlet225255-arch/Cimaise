{% extends 'frontend/_layout.twig' %}
{% import 'frontend/_axel_content_macros.twig' as labels %}

{% block styles %}
<style nonce="{{ csp_nonce() }}">
  body.axel-works-shell { background: var(--retro-paper-light); color: var(--retro-ink); }
  .axel-works-shell #main-header, .axel-works-shell > footer { display: none; }
  .axel-works-shell #main-content { margin: 0; }
  .axel-works { overflow: clip; font-family: var(--font-body, Inter, system-ui, sans-serif); }
  .axel-works-nav { display: grid; grid-template-columns: 1fr 1fr auto; align-items: start; gap: 2rem; padding: 1.35rem clamp(1rem, 2.4vw, 2rem); font-size: .68rem; line-height: 1.35; letter-spacing: .11em; text-transform: uppercase; }
  .axel-works-brand { color: inherit; font-size: .8rem; font-weight: 700; letter-spacing: -.035em; text-decoration: none; }
  .axel-works-nav__copy { color: var(--retro-muted); }
  .axel-works-nav__links { display: flex; justify-content: flex-end; gap: clamp(.8rem, 2vw, 2rem); }
  .axel-works-nav__links a { color: inherit; text-decoration: none; }
  .axel-works-nav__links a:hover { opacity: .5; }
  .axel-works-hero { min-height: 58vh; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(4rem, 10vw, 9rem) clamp(1rem, 2.4vw, 2rem) 2rem; }
  .axel-works-hero h1 { margin: 0; font-size: clamp(4rem, 20vw, 19rem); line-height: .7; font-weight: 700; letter-spacing: -.105em; text-transform: uppercase; }
  .axel-works-hero__meta { display: flex; justify-content: space-between; gap: 2rem; margin-top: 4rem; font-size: .7rem; letter-spacing: .13em; text-transform: uppercase; }
  .axel-work-category { padding: 3.5rem 0 4rem; border-top: 1px solid var(--retro-border-strong); }
  .axel-work-category__heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0 clamp(1rem, 2.4vw, 2rem) 1.25rem; }
  .axel-work-category__name { margin: 0; font-size: clamp(1.4rem, 3vw, 2.5rem); line-height: 1; font-weight: 600; letter-spacing: -.06em; text-transform: uppercase; }
  .axel-work-category__count { font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; color: var(--retro-muted); }
  .axel-work-track { display: flex; gap: .65rem; overflow-x: auto; overscroll-behavior-x: contain; padding: 0 clamp(1rem, 2.4vw, 2rem) .75rem; scrollbar-width: none; }
  .axel-work-track:focus-visible { outline: 2px solid var(--retro-ink); outline-offset: 4px; }
  .axel-work-track::-webkit-scrollbar { display: none; }
  .axel-work-card { position: relative; flex: 0 0 min(36vw, 465px); min-width: 320px; height: min(67vh, 720px); min-height: 460px; overflow: hidden; background: var(--retro-olive-dark); color: var(--retro-paper-light); text-decoration: none; }
  .axel-work-card picture, .axel-work-card img { display: block; width: 100%; height: 100%; }
  .axel-work-card img { object-fit: cover; transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .axel-work-card:hover img { transform: scale(1.04); }
  .axel-work-card::after { content: ""; position: absolute; inset: 40% 0 0; background: linear-gradient(transparent, rgba(0,0,0,.72)); pointer-events: none; }
  .axel-work-card__title { position: absolute; z-index: 2; right: 1rem; bottom: 1rem; left: 1rem; margin: 0; font-size: clamp(1.8rem, 4.2vw, 4rem); line-height: .88; letter-spacing: -.07em; text-transform: uppercase; }
  .axel-work-card__meta { display: block; margin-bottom: .65rem; font-size: .62rem; line-height: 1.3; font-weight: 400; letter-spacing: .12em; }
  .axel-work-card__veil { position: absolute; z-index: 3; top: .75rem; left: .75rem; padding: .45rem .7rem; border: 1px solid rgba(248,242,230,.8); border-radius: 99px; font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; }
  .axel-work-empty { padding: 5rem 1rem; color: var(--retro-muted); }
  .axel-works-footer { display: flex; justify-content: space-between; gap: 1rem; margin: 6rem clamp(1rem, 2.4vw, 2rem) 1rem; padding-top: .9rem; border-top: 1px solid var(--retro-border-strong); color: var(--retro-muted); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  @media (max-width: 768px) {
    .axel-works-nav { grid-template-columns: 1fr auto; gap: .8rem; }
    .axel-works-nav__copy { display: none; }
    .axel-works-nav__links { gap: .85rem; }
    .axel-works-nav__links a { font-size: .58rem; }
    .axel-works-hero { min-height: 44vh; padding: 5rem 1rem 2rem; }
    .axel-works-hero h1 { font-size: 20vw; }
    .axel-work-category { padding: 2.5rem 0; }
    .axel-work-track { display: grid; grid-template-columns: 1fr; gap: .65rem; padding: 0 1rem; }
    .axel-work-card { width: 100%; min-width: 0; height: auto; min-height: 0; aspect-ratio: .82; }
  }
  @media (max-width: 430px) {
    .axel-works-nav { padding: 1rem; }
    .axel-works-nav__links { gap: .55rem; }
    .axel-works-nav__links a { font-size: .54rem; }
    .axel-works-footer { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .axel-work-card img { transition: none; } }
  body.axel-works-shell { background: var(--retro-paper); color: var(--retro-ink); }
  .axel-works { background: var(--retro-paper); color: var(--retro-ink); }
  .axel-works-nav { grid-template-columns: minmax(9rem, 1fr) auto; align-items: center; padding: 1.1rem clamp(1rem, 3vw, 3rem); border-bottom: 1px solid rgba(41,40,32,.16); }
  .axel-works-nav__copy { display: none; }
  .axel-works-nav__links a { padding-bottom: .25rem; border-bottom: 1px solid transparent; transition: border-color .2s ease, opacity .2s ease; }
  .axel-works-nav__links a:hover, .axel-works-nav__links a[aria-current="page"] { border-color: currentColor; opacity: 1; }
  .axel-works a:focus-visible { outline: 2px solid var(--retro-oxide); outline-offset: 4px; }
  .axel-works-hero { min-height: 52vh; justify-content: center; padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4vw, 4rem) 3rem; }
  .axel-works-hero > p { margin: 0 0 1.4rem; color: var(--retro-muted); font-size: .68rem; letter-spacing: .13em; text-transform: uppercase; }
  .axel-works-hero h1 { max-width: 12ch; font-size: clamp(3.8rem, 12vw, 10rem); line-height: .84; letter-spacing: -.085em; text-transform: none; overflow-wrap: anywhere; }
  .axel-works-hero__meta { margin-top: clamp(2.5rem, 5vw, 4.5rem); padding-top: 1rem; border-top: 1px solid rgba(41,40,32,.2); color: var(--retro-muted); font-size: .65rem; }
  .axel-work-category { padding: 2.5rem 0 3.5rem; border-top-color: rgba(41,40,32,.2); }
  .axel-work-category__name { letter-spacing: -.04em; text-transform: none; }
  .axel-work-track { scroll-snap-type: x mandatory; gap: .9rem; }
  .axel-work-card { flex-basis: min(35vw, 500px); min-width: 300px; height: min(68vh, 760px); min-height: 420px; border-radius: 2px; scroll-snap-align: start; }
  .axel-work-card__title { letter-spacing: -.055em; }
  .axel-work-empty { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 1.25rem 2rem; margin: 0 clamp(1rem, 4vw, 4rem); padding: clamp(1.75rem, 5vw, 4rem); border: 1px solid rgba(41,40,32,.2); background: var(--retro-paper-mid); color: var(--retro-ink); }
  .axel-work-empty__eyebrow { grid-column: 1 / -1; color: var(--retro-muted); font-size: .62rem; letter-spacing: .13em; text-transform: uppercase; }
  .axel-work-empty h2 { max-width: 13ch; margin: 0; font-size: clamp(2rem, 5vw, 4.2rem); line-height: .95; letter-spacing: -.07em; font-weight: 500; }
  .axel-work-empty p { max-width: 34rem; margin: .75rem 0 0; color: var(--retro-muted); line-height: 1.55; }
  .axel-work-empty a { display: inline-flex; padding: .8rem 1rem; border: 1px solid var(--retro-ink); border-radius: 99px; color: inherit; font-size: .65rem; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }
  .axel-work-empty a:hover { background: var(--retro-ink); color: white; }
  .axel-works-footer { border-top-color: rgba(41,40,32,.2); color: var(--retro-muted); }
  .axel-works-footer a { color: inherit; text-decoration: none; }
  .axel-works-footer a:hover { color: var(--retro-oxide); }
  @media (max-width: 768px) {
    .axel-works-nav { grid-template-columns: 1fr auto; padding: 1rem; }
    .axel-works-nav__copy { display: none; }
    .axel-works-hero { min-height: 42svh; padding: 4rem 1rem 2.5rem; }
    .axel-works-hero h1 { font-size: clamp(3.5rem, 15vw, 6.5rem); }
    .axel-work-empty { grid-template-columns: 1fr; align-items: start; margin: 0 1rem; }
    .axel-work-empty__eyebrow { grid-column: auto; }
  }
  @media (max-width: 430px) {
    .axel-works-nav { display: flex; justify-content: space-between; gap: .6rem; }
    .axel-works-nav__links { gap: .7rem; }
    .axel-works-nav__links a { font-size: .57rem; }
    .axel-work-empty { padding: 1.5rem; }
  }
</style>
{% endblock %}

{% block content %}
<div class="axel-works">
  <nav class="axel-works-nav" aria-label="Main navigation">
    {% if site_title|default('')|trim %}<a class="axel-works-brand" href="{{ base_path }}/">{{ site_title|e }}</a>{% endif %}
    <div class="axel-works-nav__links">
      <a href="{{ base_path }}/">Trang chủ</a>
      <a href="{{ base_path }}/{{ galleries_slug|default('galleries')|e('html_attr') }}" aria-current="page">Tác phẩm</a>
      <a href="{{ about_url starts with '/' ? about_url : '/' ~ about_url }}">Giới thiệu</a>
      <a href="{{ (about_url starts with '/' ? about_url : '/' ~ about_url) ~ '#contact' }}">Liên hệ</a>
    </div>
  </nav>

  <header class="axel-works-hero" aria-labelledby="axel-works-title">
    <p>02 / Lưu trữ · {{ site_title|default('Việt Thái')|e }}</p>
    <h1 id="axel-works-title">Tác phẩm</h1>
    <div class="axel-works-hero__meta"><span>{{ albums|length }} bộ ảnh</span><span>Cuộn hoặc vuốt để khám phá →</span></div>
  </header>

  {% if albums|length > 0 %}
    <section class="axel-work-category" aria-label="Photo albums">
      <div class="axel-work-category__heading"><h2 class="axel-work-category__name">Bộ sưu tập</h2><span class="axel-work-category__count">{{ albums|length }} bộ ảnh</span></div>
      <div class="axel-work-track" role="region" aria-label="Photo albums" tabindex="0" data-horizontal-track>
        {% for album in albums %}
          {% set protected_cover = album.is_locked|default(false) or (album.is_nsfw|default(false) and not ((nsfw_consent|default(false)) or (is_admin|default(false)))) %}
          {% set cover_raw = album.cover_image ? (protected_cover ? album.cover_image.blur_path|default('') : album.cover_image.preview_path|default('')) : '' %}
          {% set cover_url = cover_raw ? (cover_raw starts with '/' ? base_path ~ cover_raw : cover_raw) : '' %}
          {% set cover_width = album.cover_image.width|default(400) %}
          {% set cover_height = album.cover_image.height|default(500) %}
          {% set lock_label = album.is_locked|default(false) ? 'Password protected' : ((album.is_nsfw|default(false) and not ((nsfw_consent|default(false)) or (is_admin|default(false)))) ? '18+' : '') %}
          <a class="axel-work-card" href="{{ base_path }}/album/{{ album.slug|e('html_attr') }}" aria-label="{{ labels.album_title(album.slug, album.title|default(''))|striptags|e('html_attr') }}">
            {% if cover_url %}<img src="{{ cover_url|e('html_attr') }}" alt="" width="{{ cover_width }}" height="{{ cover_height }}" loading="lazy" decoding="async">{% endif %}
            {% if lock_label %}<span class="axel-work-card__veil">{{ lock_label }}</span>{% endif %}
            <span class="axel-work-card__meta">{{ album.category.name|default(album.category_name|default('Tác phẩm'))|e }}{% if album.shoot_date and album.show_date|default(1) == 1 %} · {{ album.shoot_date|date('Y') }}{% endif %}</span>
            <span class="axel-work-card__title">{{ labels.album_title(album.slug, album.title|default('')) }}</span>
            <span class="axel-work-card__index" aria-hidden="true">{{ '%02d'|format(loop.index) }} ↗</span>
          </a>
        {% endfor %}
      </div>
    </section>
  {% else %}
    <section class="axel-work-empty" aria-label="No photo albums">
      <a href="{{ (about_url starts with '/' ? about_url : '/' ~ about_url) ~ '#contact' }}">Liên hệ ↗</a>
    </section>
  {% endif %}

  <footer class="axel-works-footer">{% if site_copyright|default('')|trim %}<span>{{ site_copyright|replace_year }}</span>{% endif %}<a href="{{ base_path }}/gallery?mode=playground">Trải nghiệm thư viện ↗</a><a href="{{ (about_url starts with '/' ? about_url : '/' ~ about_url) ~ '#contact' }}">Liên hệ ↗</a></footer>
</div>
{% endblock %}

{% block scripts %}
<script nonce="{{ csp_nonce() }}">
(function () {
  const tracks = document.querySelectorAll('[data-horizontal-track]');
  tracks.forEach(function (track) {
    track.addEventListener('wheel', function (event) {
      if (window.innerWidth <= 768 || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
      event.preventDefault();
      track.scrollLeft += event.deltaY;
    }, { passive: false });
    track.addEventListener('keydown', function (event) {
      if (window.innerWidth <= 768 || (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight')) return;
      event.preventDefault();
      const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      track.scrollBy({ left: event.key === 'ArrowRight' ? 320 : -320, behavior: behavior });
    });
  });
})();
</script>
{% endblock %}
